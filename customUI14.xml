<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui">
  <ribbon>
    <tabs>
      <tab id="tabExport" label="出力">
        <group id="grpExport" label="Downloads出力">
          <button id="btnExportPres"
                  label="Downloadsへ出力"
                  size="large"
                  imageMso="FileSave"
                  onAction="RibbonExportPres"/>
          <button id="btnExportPdf"
                  label="PDFで出力"
                  size="large"
                  imageMso="FileSaveAsPdfOrXps"
                  onAction="RibbonExportPdf"/>
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
